# Environment
NODE_ENV=development

# Gemini API
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Local API Server
LOCAL_API_PORT=8000
API_HOST=0.0.0.0

# Local Development (Mobile)
# Update with your local machine IP address for mobile testing
EXPO_PUBLIC_LOCAL_API_URL=http://192.168.x.x:8000/api/chat
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api

# App Info
APP_NAME=MyFirstApp
APP_VERSION=1.0.0
DEBUG=false
